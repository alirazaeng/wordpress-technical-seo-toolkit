<?xml version="1.0"?>
<ruleset name="WordPress Technical SEO Toolkit">
	<description>WordPress Coding Standards for the technical SEO toolkit.</description>
	<file>plugin</file>
	<file>examples</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="atst"/>
				<element value="ATST"/>
			</property>
		</properties>
	</rule>
</ruleset>
